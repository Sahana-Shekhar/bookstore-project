{
  "name": "bookstore-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "create-admin": "node --env-file=.env scripts/create-admin.js",
    "test": "node --env-file=.env --test --test-concurrency=1 tests/auth.test.js tests/rate-limit.test.js tests/books.test.js tests/catalogue.test.js tests/orders.test.js"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
