# Copy to .env (never commit .env). If your MongoDB requires authentication or TLS (e.g. Atlas),
# put the full connection string (with credentials) in .env only.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
# PostgreSQL (local only). Replace <DB_USER>, <DB_PASSWORD> and the database name for your machine.
# <DB_PASSWORD> must be URL-encoded (for example, "@" becomes "%40", "#" becomes "%23"). Never commit the real value.
# Development database must be named exactly "bookstore"; tests derive "bookstore_test" automatically.
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/bookstore?schema=public"
MONGODB_URI=mongodb://127.0.0.1:27017/bookstore

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Keep it secret and never commit the real value.
JWT_SECRET=
JWT_EXPIRES_MINUTES=60
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=300
